upstream lamma_api {
  server api:8000;
  keepalive 32;
}

server {
  listen 8080;
  root /usr/share/nginx/html;
  include /tmp/security-headers.inc;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  # Waiting-room SSE: no buffering, heartbeat every 25s keeps it under 60s.
  location ~ ^/api/v1/meetings/[^/]+/admission/events$ {
    include /etc/nginx/proxy-api.inc;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 60s;
    proxy_pass http://lamma_api;
  }

  location /api/ {
    include /etc/nginx/proxy-api.inc;
    proxy_read_timeout 20s;
    proxy_pass http://lamma_api;
  }

  # Internal routes (webhooks, metrics) are never exposed publicly.
  location /internal/ { return 404; }
  location = /metrics { return 404; }

  location /assets/ {
    include /tmp/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    include /tmp/security-headers.inc;
    try_files $uri /index.html;
  }
}
