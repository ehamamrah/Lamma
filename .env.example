# Copy to .env and adjust. Every value has a dev default in compose.yaml, so
# `docker compose up --build` works without a .env file. In production
# (compose.prod.yaml) every secret below is REQUIRED and dev values are rejected.

# --- Application -------------------------------------------------------------
APP_ENV=development              # development | production
LOG_LEVEL=info                   # debug | info | warn | error
PUBLIC_BASE_URL=http://localhost:8080
WEB_PORT=8080
COOKIE_SECURE=false              # must be true in production (HTTPS)
TRUSTED_PROXY_CIDRS=172.30.0.10/32  # Nginx's fixed address; never a broad range
CORS_ALLOWED_ORIGINS=            # empty = same-origin only

# --- Secrets (generate with: openssl rand -base64 48) ---------------------------
POSTGRES_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
ORIGIN_HASH_KEY=change-me-at-least-32-bytes-random

# --- Database / Redis ----------------------------------------------------------
DB_MAX_CONNS=20

# --- LiveKit -------------------------------------------------------------------
LIVEKIT_API_KEY=lammadevkey
LIVEKIT_API_SECRET=change-me-at-least-32-bytes-random
LIVEKIT_PUBLIC_URL=ws://localhost:7880    # browser URL; wss://rtc.example.com in prod
LIVEKIT_NODE_IP=127.0.0.1                 # LAN IP to test from phones; public IP in prod
LIVEKIT_USE_EXTERNAL_IP=false             # true in prod (STUN discovery)
LIVEKIT_TOKEN_TTL=2m                      # also the seat lease
LIVEKIT_ROOM_MAX_PARTICIPANTS=51          # MEETING_MAX_PARTICIPANTS + 1 (host seat)
LIVEKIT_TURN_DOMAIN=localhost             # turn.example.com in prod
LIVEKIT_TURN_TLS_PORT=0                   # 5349 in prod (needs cert)
LIVEKIT_TURN_EXTERNAL_TLS=false
CSP_CONNECT_SRC=ws://localhost:7880 http://localhost:7880

# --- Meetings ------------------------------------------------------------------
MEETING_DEFAULT_TTL=24h
MEETING_MAX_TTL=168h
MEETING_MAX_PARTICIPANTS=50
MEETING_RETENTION=168h

# --- Rate limits (requests/period; see PLAN.md §10) ----------------------------
RATE_LIMIT_GENERAL=120/m
RATE_LIMIT_CREATE=10/h
RATE_LIMIT_LOOKUP=30/m
RATE_LIMIT_JOIN_IP=10/m
RATE_LIMIT_JOIN_MEETING=5/m             # per IP per meeting (sessionless callers)
RATE_LIMIT_PASSWORD=5/15m
RATE_LIMIT_TOKEN=6/m
RATE_LIMIT_CHAT=20/10s
RATE_LIMIT_CHAT_MEETING=10/s
RATE_LIMIT_MODERATION=60/m

# --- Resilience ----------------------------------------------------------------
ARGON2_MAX_CONCURRENT=           # empty = number of CPUs
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_TIMEOUT=30s
LIVEKIT_CALL_TIMEOUT=3s

# --- Observability -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=     # empty disables tracing export

# --- Production only (compose.prod.yaml) ---------------------------------------
# APP_DOMAIN=meet.example.com
# RTC_DOMAIN=rtc.example.com
# TLS_CERT_DIR=/etc/lamma/tls
# LB_CIDR=10.0.0.0/16
